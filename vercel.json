{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/frontend/homepage_sample/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/homepage_sample/index.html"
    },
    {
      "src": "/builder",
      "dest": "/frontend/homepage_sample/index.html"
    },
    {
      "src": "/ats",
      "dest": "/frontend/homepage_sample/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login_page/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
