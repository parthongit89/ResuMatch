{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/style.css", "dest": "/frontend/homepage_sample/style.css" },
    { "src": "/script.js", "dest": "/frontend/homepage_sample/script.js" },
    { "src": "/homepage/style.css", "dest": "/frontend/homepage_sample/style.css" },
    { "src": "/homepage/script.js", "dest": "/frontend/homepage_sample/script.js" },
    { "src": "/builder/style.css", "dest": "/frontend/Feature modules/1.resume_builder/style.css" },
    { "src": "/builder/script.js", "dest": "/frontend/Feature modules/1.resume_builder/script.js" },
    { "src": "/ats/style.css", "dest": "/frontend/Feature modules/2.ats-matcher/style.css" },
    { "src": "/ats/script.js", "dest": "/frontend/Feature modules/2.ats-matcher/script.js" },
    { "src": "/", "dest": "/frontend/homepage_sample/index.html" },
    { "src": "/dashboard", "dest": "/frontend/homepage_sample/index.html" },
    { "src": "/builder", "dest": "/frontend/homepage_sample/index.html" },
    { "src": "/ats", "dest": "/frontend/homepage_sample/index.html" },
    { "src": "/login", "dest": "/frontend/login_page/index.html" },
    { "src": "/api/(.*)", "dest": "https://resumatch-api-jkau.onrender.com/api/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
